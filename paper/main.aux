\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Reconstructed images under three input conditions (Real, Shuffled, Random) for three representative categories (goldfish, butterfly, bicycle), showing four repetitions each. The Real and Shuffled rows are visually indistinguishable despite the large difference in BC, demonstrating that visual quality cannot distinguish brain-controlled from prior-dominated reconstruction. Images are generated by the relu7generator from relu7 decoded features; BC values refer to the \texttt  {cnn8} decoder (\cref  {tab:main}).}}{9}{figure.1}\protected@file@percent }
\newlabel{fig:recon}{{1}{9}{Reconstructed images under three input conditions (Real, Shuffled, Random) for three representative categories (goldfish, butterfly, bicycle), showing four repetitions each. The Real and Shuffled rows are visually indistinguishable despite the large difference in BC, demonstrating that visual quality cannot distinguish brain-controlled from prior-dominated reconstruction. Images are generated by the relu7generator from relu7 decoded features; BC values refer to the \texttt {cnn8} decoder (\cref {tab:main})}{figure.1}{}}
\newlabel{fig:recon@cref}{{[figure][1][]1}{[1][8][]9}{}{}{}}
